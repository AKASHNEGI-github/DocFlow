# Copy this file to .env and fill in real values before running the server.

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API (the frontend's dev/prod URL).
CORS_ORIGIN=http://localhost:5173

# --- Postgres ---
# Either set DATABASE_URL, or the individual PG_* vars below - db.js
# prefers DATABASE_URL when both are present.
DATABASE_URL=postgres://docflow:docflow@localhost:5432/docflow
PG_HOST=localhost
PG_PORT=5432
PG_USER=docflow
PG_PASSWORD=docflow
PG_DATABASE=docflow

# --- Auth tokens ---
# Use long, random values in any real environment - these are dev placeholders only.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# --- Password reset ---
PASSWORD_RESET_EXPIRES_IN_MINUTES=30
# Base URL the reset email's link is built from, e.g. https://app.example.com/reset-password
FRONTEND_RESET_PASSWORD_URL=http://localhost:5173/reset-password

# --- Outbound email (forgot-password) ---
# DocFlow only ever logs the reset link to the console when SMTP_HOST is
# unset, so the flow is runnable out of the box without a mail provider.
# Set these to send real emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="DocFlow <no-reply@docflow.local>"
